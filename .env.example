# Copy to `.env` and fill in with your own values.
#
# The production site is a fully static build with no server runtime, so none of
# these are required to build or deploy it. They only matter for `npm run dev`
# and for any Supabase-backed feature you add later.

# --- Site ---
# Public origin, used to build absolute URLs in sitemap.xml at build time.
# Defaults to https://fortunersgroup.com when unset.
SITE_URL=

# --- Supabase ---
# Find these in the Supabase dashboard under Project Settings > API.
SUPABASE_PROJECT_ID=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Server-only. Bypasses row-level security — never expose this to the client
# and never commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Client-side equivalents (bundled into the browser build by Vite).
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
