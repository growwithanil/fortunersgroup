# Copy to `.env` and fill in with your own values.

# --- Supabase ---
# Find these in the Supabase dashboard under Project Settings > API.
SUPABASE_PROJECT_ID=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Server-only. Bypasses row-level security — never expose this to the client
# and never commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Client-side equivalents (bundled into the browser build by Vite).
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- Lovable AI gateway ---
# Server-only. Powers the chatbot at /api/chat.
LOVABLE_API_KEY=
